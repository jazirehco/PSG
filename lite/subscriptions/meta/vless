      - '🚩 CF | 🔒 VLESS | @NamiraConfigs [56]'
      - '🚩 CF | 🔒 VLESS | @NamiraConfigs [57]'
      - '🇮🇷 IR | 🔒 VLESS | @NamiraConfigs [58]'

  - name: 🌍 Global Media
    type: select
    proxies:
      - 🚀 Proxy
      - ♻️ Auto
      - 🎯 Direct

  - name: 🎯 Direct
    type: select
    proxies:
      - DIRECT

  - name: 🛑 Ad Block
    type: select
    proxies:
      - REJECT
      - DIRECT

  - name: 🐟 Fallback
    type: select
    proxies:
      - 🚀 Proxy
      - 🎯 Direct


proxy-groups:
  - name: 🚀 Proxy
    type: select
    proxies:
      - ♻️ Auto
      - 🎯 Direct

  - name: ♻️ Auto
    type: url-test
    url: http://www.gstatic.com/generate_204
    interval: 300
    proxies: 
      - '🇬🇧 GB | 🔓 VLESS | @NamiraConfigs [30]'
      - '🇬🇧 GB | 🔓 VLESS | @NamiraConfigs [31]'
      - '🇩🇪 DE | 🔓 VLESS | @NamiraConfigs [39]'
      - '🇬🇷 GR | 🔓 VLESS | @NamiraConfigs [43]'

  - name: 🌍 Global Media
    type: select
    proxies:
      - 🚀 Proxy
      - ♻️ Auto
      - 🎯 Direct

  - name: 🎯 Direct
    type: select
    proxies:
      - DIRECT

  - name: 🛑 Ad Block
    type: select
    proxies:
      - REJECT
      - DIRECT

  - name: 🐟 Fallback
    type: select
    proxies:
      - 🚀 Proxy
      - 🎯 Direct

